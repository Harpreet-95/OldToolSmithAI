# Copy this file to .env and fill in real values before starting the server.
# Never commit .env — it is listed in .gitignore.

# Runtime environment: development | production
APP_ENV=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# API keys — must be at least 32 characters and not match known default values.
# Generate a strong key with:
#   python -c "import secrets; print('tsm_' + secrets.token_hex(24))"
ADMIN_API_KEY=your-strong-admin-api-key-here

USER_API_KEY=your-strong-user-api-key-here

# Fernet symmetric encryption key for audit log field encryption.
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Changing this key makes all existing encrypted audit records unreadable.
ENCRYPTION_KEY=your-fernet-encryption-key-here

# HMAC salt used to derive a stable, opaque user_id from each API key.
# Generate once with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Changing this salt invalidates all stored user_id values in audit and execution history.
USER_ID_SALT=your-user-id-salt-here

# Number of days to retain audit and execution records before purging.
# Records older than this are deleted when POST /admin/purge is called.
# Defaults to 90 if not set. Adjust to match your compliance policy.
RETENTION_DAYS=7

# Retry settings for failed execution steps.
# MAX_STEP_RETRIES: number of retry attempts after the first failure (0 = no retry).
# RETRY_BACKOFF_SECONDS: wait time multiplier in seconds between retries (linear backoff).
# ValueError and TypeError are never retried — those are permanent configuration errors.
MAX_STEP_RETRIES=2
RETRY_BACKOFF_SECONDS=1.0

# ---------------------------------------------------------------------------
# CORS — comma-separated list of frontend origins the browser is allowed to call
# the API from. In production replace with your deployed frontend URL.
# Example (multiple origins): ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# SMTP email delivery
# Set ENABLE_REAL_EMAIL=true to send real emails via SMTP.
# When false (default) the system returns a clear "disabled" result — no fake success.
# ---------------------------------------------------------------------------

# Master switch — must be explicitly true to send any email.
ENABLE_REAL_EMAIL=false

# SMTP server — port 587 + STARTTLS is the standard for Gmail, SendGrid, Mailgun, etc.
# Use port 465 for implicit SSL (the code detects this automatically).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# SMTP credentials
SMTP_USERNAME=your-smtp-username@gmail.com
SMTP_PASSWORD=your-app-password-here

# The From address shown in sent emails. Usually the same as SMTP_USERNAME.
SMTP_FROM_EMAIL=your-smtp-username@gmail.com

# ---------------------------------------------------------------------------
# Background scheduler
#
# SCHEDULER_ENABLED          — master switch; leave true in all environments.
#                              Set false only if you explicitly want to run without
#                              autonomous workflow execution (rare; prefer pausing
#                              individual workflows instead).
#
# SCHEDULER_INTERVAL_SECONDS — how often the scheduler polls for due workflows.
#                              60s is the recommended default. Increase in production
#                              if DB polling is a concern.
#
# SCHEDULER_MAX_RUNS_PER_TICK — hard cap on workflows executed per poll cycle.
#                              Prevents restart floods in local dev (use 3).
#                              Production with many active workflows can use 10+.
#
# SCHEDULER_LOG_LEVEL        — "summary" logs one line per tick (recommended).
#                              "verbose" logs one line per workflow (use for debugging).
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_MAX_RUNS_PER_TICK=3
SCHEDULER_LOG_LEVEL=summary

# ---------------------------------------------------------------------------
# AI Workflow Planner (optional)
# Requires: pip install "openai>=1.0,<2.0"
# When ENABLE_AI_PLANNER=false (default) the rule-based interpreter runs exclusively.
# When true and OPENAI_API_KEY is set, the AI planner enhances task interpretation.
# Any AI failure automatically falls back to the rule-based interpreter.
# ---------------------------------------------------------------------------
ENABLE_AI_PLANNER=false
ENABLE_AI_REPORT_NARRATIVE=false
ENABLE_AI_ASSISTANT=false
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# SQL rebuild Phase 2, Step 2 — schema-document embeddings
# Reuses OPENAI_API_KEY above; no separate credential system.
# ---------------------------------------------------------------------------
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536
# SQL_EMBEDDING_MAX_BATCH_ITEMS=64
# SQL_EMBEDDING_MAX_BATCH_CHARS=100000

# ---------------------------------------------------------------------------
# SQL rebuild Phase 3, Step 1 — structured text-to-SQL generation
# Reuses OPENAI_API_KEY/OPENAI_MODEL/OPENAI_TIMEOUT_SECONDS above; no
# separate credential or model configuration.
# ---------------------------------------------------------------------------
# SQL_GENERATION_MAX_QUESTION_CHARACTERS=2000
# SQL_GENERATION_MAX_OUTPUT_TOKENS=1200
# SQL_GENERATION_MAX_SQL_CHARACTERS=4000
# SQL_GENERATION_MAX_INTERPRETATION_CHARACTERS=500
# SQL_GENERATION_MAX_REFERENCED_OBJECTS=20
# SQL_GENERATION_MAX_ASSUMPTIONS=10
# SQL_GENERATION_MAX_ASSUMPTION_CHARACTERS=300
# SQL_GENERATION_MAX_CLARIFICATION_CHARACTERS=500
# SQL_GENERATION_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# SQL rebuild Phase 3, Step 2 — strict SQL Server read-only query validation
# Defensive limits only — never SQL execution.
# ---------------------------------------------------------------------------
# SQL_VALIDATION_MAX_SQL_CHARACTERS=8000
# SQL_VALIDATION_MAX_AST_NODES=500
# SQL_VALIDATION_MAX_CTES=10
# SQL_VALIDATION_MAX_JOINS=15
# SQL_VALIDATION_MAX_REFERENCED_OBJECTS=20

# ---------------------------------------------------------------------------
# SQL rebuild Phase 4, Step 2 — connection-time retrieval preparation
# When true, data.datasource_service.run_connect_bootstrap_job() (the
# existing background job that already runs after every new SQL connection)
# also builds this source's retrieval documents/embeddings/vector index via
# core.sqlservice.retrieval_preparation.prepare_source_for_retrieval(), so a
# question asked right after connecting doesn't have to wait for that work
# to happen first. Reuses OPENAI_API_KEY/OPENAI_EMBEDDING_MODEL/
# OPENAI_EMBEDDING_DIMENSIONS above; no separate credential. Best-effort —
# a failure here never fails the connection or the background job. Default
# false (opt-in).
# ---------------------------------------------------------------------------
# SQL_RETRIEVAL_PREPARATION_ON_CONNECT_ENABLED=false

# ---------------------------------------------------------------------------
# AI planning flags still read by shared (non-question-answering) components
# such as executive-report KPI planning. Requires: a valid OPENAI_API_KEY
# above. Default true.
# ---------------------------------------------------------------------------
ENABLE_AI_QUESTION_INTERPRETER=true
ENABLE_AI_PHYSICAL_PLANNER=true
ENABLE_AI_CANDIDATE_ADJUDICATION=true
OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_SECONDS=10  # seconds before AI call is abandoned and fallback runs

# ---------------------------------------------------------------------------
# AI Workspace Autonomous Mode
# When true, engine tools saved via the AI Workspace "Save as Reusable
# Workflow" CTA are auto-approved (draft→pending→approved) immediately, so
# "Run Again" executes the real saved tool graph without manual governance.
#
# Set to true for:  demo, free-trial, autonomous orchestration deployments.
# Set to false for: enterprise tenants requiring submit→approve governance.
#
# The full approval state machine is still exercised when auto-approving —
# SUBMITTED + APPROVED audit events are recorded with actor="system:auto_approve".
# Future: replace with per-tenant governance policy / RBAC compliance mode.
# ---------------------------------------------------------------------------
ENABLE_AUTO_APPROVE_ENGINE_TOOLS=false

# ---------------------------------------------------------------------------
# Question answering for a connected SQL datasource — the ONE architecture
# (Phase 8A): the AI-first fast path (core.sqlservice.ai_first_fast_path_service),
# used by POST /v1/composer/ask and POST /v1/sources/{id}/execute-query.
#
# AI_FIRST_SQL_FAST_PATH_ENABLED + AI_FIRST_SQL_FAST_PATH_SOURCE_IDS is the
# single enablement gate: the global flag AND an explicit comma-separated
# allow-list of source ids (e.g. "10004"). A source not enabled here gets a
# typed "not enabled" answer — there is no fallback to any other pipeline.
# Both default off. Never enable for a source whose retrieval build, business
# knowledge, and view profiling have not been prepared and verified.
# ---------------------------------------------------------------------------
AI_FIRST_SQL_FAST_PATH_ENABLED=false
AI_FIRST_SQL_FAST_PATH_SOURCE_IDS=

# Model for the single combined planning call. Leave unset to use the plain
# OPENAI_MODEL default (safe, but not the validated configuration).
AI_FIRST_SCHEMA_SELECTION_MODEL=gpt-6-sol
AI_FIRST_SCHEMA_SELECTION_REASONING_EFFORT=medium
